# {{ ansible_managed }} — меняйте переменные playbook, а не этот файл
{% if feed_https | bool %}
COMPOSE_FILE=compose.yaml:compose.https.yaml
FEED_DOMAIN={{ feed_domain }}
FEED_HTTPS_PORT={{ feed_https_port }}
{% endif %}
FEED_INSTANCE={{ feed_instance }}
FEED_IMAGE={{ feed_image }}
FEED_BIND={{ feed_bind }}
FEED_HTTP_PORT={{ feed_http_port }}
FEED_PUBLIC_URL={{ feed_public_url | regex_replace('/$', '') }}
FEED_ADMIN_URL={{ feed_admin_url }}
FEED_OWNER={{ feed_owner }}
FEED_SCHEDULE={{ feed_schedule }}
TZ={{ feed_timezone }}
FEED_RUN_ON_START={{ '1' if feed_run_on_start | bool else '0' }}
FEED_UID={{ feed_uid }}
FEED_GID={{ feed_gid }}
{% for name, value in feed_env.items() %}
{{ name }}={{ value }}
{% endfor %}
